<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Kufus</vendor>
  <vendor_url>https://github.com/drlacheheb/kufus</vendor_url>
  <icon_name>drive-removable-media</icon_name>
  <action id="io.github.drlacheheb.kufus.worker">
    <description>Run privileged Kufus disk operations</description>
    <message>Authentication is required by Kufus to write or eject the selected USB drive.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/kufus/lib/app/resources/kufus-worker</annotate>
  </action>
</policyconfig>
